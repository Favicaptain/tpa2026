rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }

    match /news/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /national_execos/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /state_coordinators/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /user_roles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}